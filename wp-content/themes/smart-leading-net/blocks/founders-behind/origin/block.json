{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smartleading/founders-origin",
  "title": "Founders Behind — Origin Story",
  "category": "smartleading-founders",
  "description": "Founders Behind — Origin Story",
  "icon": "book-alt",
  "keywords": [
    "founders",
    "smart leading"
  ],
  "textdomain": "smart-leading-net",
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "align": false,
    "className": true
  },
  "attributes": {
    "headingTag": {
      "type": "string",
      "default": "h2"
    },
    "eyebrow": {
      "type": "string",
      "default": "Our story"
    },
    "heading": {
      "type": "string",
      "default": "Why We Started Smart Leading"
    },
    "story": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "isPublished": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "smartleading-founders-editor",
  "editorStyle": "smartleading-founders-editor-style",
  "style": "sln-founders-behind"
}
