    },
    "primaryShow": {
      "type": "boolean",
      "default": true
    },
    "secondaryLabel": {
      "type": "string",
      "default": ""
    },
    "secondaryUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryNewTab": {
      "type": "boolean",
      "default": false
    },
    "secondaryShow": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "smartleading-locel-seo-editor",
  "editorStyle": "smartleading-locel-seo-editor-style",
  "style": "sln-locel-seo"
