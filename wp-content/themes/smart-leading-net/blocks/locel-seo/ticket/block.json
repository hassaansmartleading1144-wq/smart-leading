{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smartleading/locel-seo-ticket",
  "title": "Local SEO — Audit CTA",
  "category": "smartleading-locel-seo",
  "description": "Local SEO — Audit CTA",
  "icon": "tickets-alt",
  "keywords": [
    "local seo",
    "locale seo"
  ],
  "textdomain": "smart-leading-net",
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "align": false,
    "className": true
